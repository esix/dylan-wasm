+// wasm32
+
+define abstract class <llvm-wasm32-back-end> (<llvm-back-end>)
+end class;
+
+define method back-end-word-size
+    (back-end :: <llvm-wasm32-back-end>)
+ => (number-bytes :: <integer>)
+  4
+end method back-end-word-size;
+
+define method llvm-back-end-data-layout
+    (back-end :: <llvm-wasm32-back-end>) => (layout :: <string>);
+  "e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20"
+end method;
+
+define method llvm-back-end-unwind-exception-size
+    (back-end :: <llvm-wasm32-back-end>)
+ => (number-words :: <integer>)
+  8
+end method;
+
+define method llvm-back-end-unwind-exception-alignment
+    (back-end :: <llvm-wasm32-back-end>)
+ => (alignment-bytes :: <integer>)
+  16
+end method;
+
+// wasm64 (memory64) — 64-bit pointers, reuses the well-tested 64-bit codegen
+// path (wasm32's 32-bit pointers tripped invalid size-dependent bitcasts in the
+// runtime generator).
+
+define abstract class <llvm-wasm64-back-end> (<llvm-back-end>)
+end class;
+
+define method back-end-word-size
+    (back-end :: <llvm-wasm64-back-end>)
+ => (number-bytes :: <integer>)
+  8
+end method back-end-word-size;
+
+define method llvm-back-end-data-layout
+    (back-end :: <llvm-wasm64-back-end>) => (layout :: <string>);
+  "e-m:e-p:64:64-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20"
+end method;
+
+define method llvm-back-end-unwind-exception-size
+    (back-end :: <llvm-wasm64-back-end>)
+ => (number-words :: <integer>)
+  4
+end method;
+
+define method llvm-back-end-unwind-exception-alignment
+    (back-end :: <llvm-wasm64-back-end>)
+ => (alignment-bytes :: <integer>)
+  16
+end method;
+
