 /// LLVM Thread-local storage platform support
 
 define method llvm-runtime-thread-local-support?
@@ -346,3 +432,17 @@ define method llvm-thread-local-support?
  => (support? :: <boolean>)
   #f
 end method;
+
+// wasm is single-threaded here, and wasm thread-local lowering needs __tls_base
+// set up by a _start/__wasm_init_tls we don't have (--no-entry). Emit the TEB
+// (Pteb) as a plain global instead so address-taking and access don't fault.
+
+define method llvm-runtime-thread-local-support?
+    (back-end :: <llvm-wasm32-back-end>) => (support? :: <boolean>)
+  #f
+end method;
+
+define method llvm-runtime-thread-local-support?
+    (back-end :: <llvm-wasm64-back-end>) => (support? :: <boolean>)
+  #f
+end method;
