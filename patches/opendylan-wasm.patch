 /// Concrete LLVM back-end subclasses
 
 // x86-windows
@@ -327,6 +386,33 @@ define method llvm-back-end-target-triple
 end method;
 
 
+// wasm32-wasi
+
+define class <llvm-wasm32-wasi-back-end> (<llvm-wasm32-back-end>,
+                                          <llvm-unix-back-end>)
+end class;
+
+register-back-end(<llvm-wasm32-wasi-back-end>, #"llvm", #"wasm32-wasi");
+
+define method llvm-back-end-target-triple
+    (back-end :: <llvm-wasm32-wasi-back-end>) => (triple :: <string>);
+  "wasm32-unknown-wasi"
+end method;
+
+// wasm64-wasi
+
+define class <llvm-wasm64-wasi-back-end> (<llvm-wasm64-back-end>,
+                                          <llvm-unix-back-end>)
+end class;
+
+register-back-end(<llvm-wasm64-wasi-back-end>, #"llvm", #"wasm64-wasi");
+
+define method llvm-back-end-target-triple
+    (back-end :: <llvm-wasm64-wasi-back-end>) => (triple :: <string>);
+  "wasm64-unknown-wasi"
+end method;
