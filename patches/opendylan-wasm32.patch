diff --git a/sources/dfmc/llvm-back-end/llvm-targets.dylan b/sources/dfmc/llvm-back-end/llvm-targets.dylan
index b6acc38..3ef3cfa 100644
--- a/sources/dfmc/llvm-back-end/llvm-targets.dylan
+++ b/sources/dfmc/llvm-back-end/llvm-targets.dylan
@@ -187,6 +187,35 @@ define method llvm-back-end-calling-convention-fast
 end method;
 
 
+// wasm32
+
+define abstract class <llvm-wasm32-back-end> (<llvm-back-end>)
+end class;
+
+define method back-end-word-size
+    (back-end :: <llvm-wasm32-back-end>)
+ => (number-bytes :: <integer>)
+  4
+end method back-end-word-size;
+
+define method llvm-back-end-data-layout
+    (back-end :: <llvm-wasm32-back-end>) => (layout :: <string>);
+  "e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20"
+end method;
+
+define method llvm-back-end-unwind-exception-size
+    (back-end :: <llvm-wasm32-back-end>)
+ => (number-words :: <integer>)
+  8
+end method;
+
+define method llvm-back-end-unwind-exception-alignment
+    (back-end :: <llvm-wasm32-back-end>)
+ => (alignment-bytes :: <integer>)
+  16
+end method;
+
+
 /// Concrete LLVM back-end subclasses
 
 // x86-windows
@@ -327,6 +356,20 @@ define method llvm-back-end-target-triple
 end method;
 
 
+// wasm32-wasi
+
+define class <llvm-wasm32-wasi-back-end> (<llvm-wasm32-back-end>,
+                                          <llvm-unix-back-end>)
+end class;
+
+register-back-end(<llvm-wasm32-wasi-back-end>, #"llvm", #"wasm32-wasi");
+
+define method llvm-back-end-target-triple
+    (back-end :: <llvm-wasm32-wasi-back-end>) => (triple :: <string>);
+  "wasm32-unknown-wasi"
+end method;
+
+
 /// LLVM Thread-local storage platform support
 
 define method llvm-runtime-thread-local-support?
diff --git a/sources/jamfiles/shared-darwin-build.jam b/sources/jamfiles/shared-darwin-build.jam
